# Copiá este archivo como .env.local y completá lo que necesites. Todo es opcional.

# Postgres de Neon (Vercel lo agrega solo al conectar la base). Sin esto se usa PGlite local.
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Contraseña para entrar a la app (recomendado al publicarla).
# APP_PASSWORD=

# Secreto extra para firmar la cookie de sesión.
# AUTH_SECRET=

# Carpeta de la base local PGlite (por defecto ~/.organizaditto/pgdata).
# PGLITE_DIR=

# Carpeta del backup automático diario (por defecto OneDrive/Organizaditto/backups). AUTO_BACKUP=0 lo desactiva.
# BACKUP_DIR=
# AUTO_BACKUP=0
